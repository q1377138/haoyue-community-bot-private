[Unit]
Description=Haoyue RAG SSH tunnel to 216 internal RAG
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -NT -i /home/ubuntu/.ssh/haoyue_rag_tunnel_ed25519 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -L 127.0.0.1:18080:127.0.0.1:18080 root@216.195.211.69
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

